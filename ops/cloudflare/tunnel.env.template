# Cloudflare hostnames for this deployment. Copy to tunnel.env and fill in
# with YOUR OWN zone — nothing here is guessed or defaulted to a domain.
# The zone must already exist in the Cloudflare account you authenticate
# cloudflared with.

# The tunnel's UUID, printed by `cloudflared tunnel create aulalite`.
CF_TUNNEL_ID=

# Hostnames (no scheme). All three must be inside your Cloudflare zone.
CF_APP_HOSTNAME=
CF_HLS_HOSTNAME=
CF_WEBRTC_HOSTNAME=

# Full origins (with https://). Must match the hostnames above.
CF_APP_URL=
CF_HLS_URL=
CF_WEBRTC_URL=

# Optional: public origin for presigned object-storage URLs. Leave unset
# unless you also expose RustFS through the tunnel; the signature covers
# this host, so it must be what the browser actually requests.
CF_STORAGE_URL=

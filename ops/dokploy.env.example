# AulaLite production environment contract for Dokploy.
#
# Paste this file into Dokploy's Environment editor, then replace every required
# blank or placeholder before the first production deploy. Leave an optional
# blank only when that integration is deliberately disabled. Dokploy stores the
# resulting file outside Git; never copy completed values into this repository.
# See ops/README.md#dokploy-deployment for bootstrap and validation steps.
# Dokploy owns COMPOSE_PROJECT_NAME; do not override it or scheduled jobs and
# named-volume backups can lose the application association.

# Canonical public origins. Keep each value to a bare HTTPS origin with no path,
# query, fragment, or trailing slash. Browser origins is an exact CORS allowlist.
APP_ORIGIN=https://aula.elementors.guru
API_ORIGIN=https://api.aula.elementors.guru
AULALITE_BROWSER_ORIGINS=https://aula.elementors.guru,https://admin.elementors.guru
AULALITE_API_BASE_URL=https://api.aula.elementors.guru
AULALITE_APP_ORIGIN=https://aula.elementors.guru
AULALITE_ADMIN_ORIGIN=https://admin.elementors.guru
# Comma-separated Firebase emails with platform-wide super-admin access.
AULALITE_SUPER_ADMIN_EMAILS=owner@example.com
SELF_SERVICE_SIGNUP_ENABLED=true
RUST_LOG=info,sqlx=warn

# PostgreSQL. POSTGRES_PASSWORD initializes the schema owner on a new volume.
# DATABASE_URL must authenticate as the exact NOBYPASSRLS `aulalite_app` role;
# MIGRATION_DATABASE_URL must authenticate as the schema owner. Percent-encode
# passwords when placing them in URLs. Follow the first-deploy role bootstrap
# in ops/README.md before expecting the backend to become ready.
POSTGRES_USER=aulalite
POSTGRES_PASSWORD=
POSTGRES_DB=aulalite
# Fresh-volume bootstrap password for the `aulalite_app` runtime role. Keep the
# raw password here and put the same logical password, URL-percent-encoded, in
# DATABASE_URL. Changing it after the volume exists does not rotate the database
# role automatically.
POSTGRES_RUNTIME_PASSWORD=
# Examples (do not paste literally):
#   postgresql://aulalite:<encoded-owner-password>@postgres:5432/aulalite
#   postgresql://aulalite_app:<encoded-runtime-password>@postgres:5432/aulalite
MIGRATION_DATABASE_URL=
DATABASE_URL=
DB_MAX_CONNECTIONS=20
DB_MIN_CONNECTIONS=0
DB_ACQUIRE_TIMEOUT_SECS=10
DB_IDLE_TIMEOUT_SECS=600
DB_MAX_LIFETIME_SECS=1800

# Publishable Firebase Web configuration. These values are visible to browsers
# by design; Firebase rules and authorized-domain settings remain the security
# boundary. Add aula.elementors.guru and admin.elementors.guru to Firebase
# Authentication authorized domains. The backend verifies every ID token.
# Issuer format: https://securetoken.google.com/<project-id>
# Auth-domain format: <project-id>.firebaseapp.com (or its configured equivalent)
FIREBASE_PROJECT_ID=
FIREBASE_JWKS_URL=https://www.googleapis.com/service_accounts/v1/jwk/securetoken@system.gserviceaccount.com
FIREBASE_TOKEN_ISSUER=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
FCM_VAPID_KEY=

# S3-compatible object storage. The signing endpoint is deliberately public
# because browsers upload/download presigned URLs and the signed Host must match.
# The production Compose file fixes the private endpoint to http://rustfs:9000
# for bucket bootstrap/object APIs and automatically reconciles an exact
# AULALITE_BROWSER_ORIGINS bucket CORS policy before serving. Route
# storage.elementors.guru to the RustFS service on port 9000.
S3_ENDPOINT_URL=https://storage.elementors.guru
S3_REGION=us-east-1
S3_BUCKET=aulalite
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Live classroom. Route the HTTPS hosts to different MediaMTX ports:
#   live.elementors.guru   -> mediamtx:8889 (WHIP/WHEP signalling)
#   stream.elementors.guru -> mediamtx:8888 (HLS playback)
# MEDIAMTX_ADDITIONAL_HOSTS is a comma-separated public node IP and/or DNS name
# advertised as an ICE candidate (no scheme or port). Forward UDP 8189 from the
# Internet to the deployment node. Ports 9997/9998 must remain private.
MEDIAMTX_PUBLIC_WEBRTC_URL=https://live.elementors.guru
MEDIAMTX_PUBLIC_HLS_URL=https://stream.elementors.guru
MEDIAMTX_ADDITIONAL_HOSTS=
MEDIAMTX_AUTH_SHARED_HEADER=
# Literal PKCS#8 RSA private key PEM. In Dokploy's dotenv editor, wrap the whole
# multiline value in single quotes as shown in ops/README.md. Do not use bare PEM
# lines or replace newlines with the two characters `\n`.
JWT_RS256_PRIVATE_KEY_PEM=
LIVE_ROOM_CHAT_RETENTION_DAYS=90
LIVE_ROOM_RECORDING_RETENTION_DAYS=365

# TURN is a launch gate for reliable classes on restrictive school/corporate
# networks. Use a TLS TURN endpoint and short-lived/scoped credentials where the
# provider supports them.
AULALITE_TURN_URL=
AULALITE_TURN_USERNAME=
AULALITE_TURN_CREDENTIAL=

# Stripe. The secret key and webhook signing secret are server-only. Register
# https://api.aula.elementors.guru/v1/stripe/webhook in Stripe after the first healthy
# deploy, then place that endpoint's whsec value below.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_PRO=

# Transactional email is required in production. RESEND_FROM must be a verified
# sender/domain in the provider account.
RESEND_API_KEY=
RESEND_FROM=

# Optional FCM HTTP v1 server push. Use one-line service-account JSON in
# FCM_SERVICE_ACCOUNT_JSON for Dokploy. Do not set the *_PATH alternative unless
# a secret file is also mounted into the backend container.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
FCM_SERVICE_ACCOUNT_JSON_PATH=
FCM_TOKEN_URI=https://oauth2.googleapis.com/token
FCM_BASE_URL=https://fcm.googleapis.com

# Application security. Generate independent values: SSO_SESSION_SECRET should
# contain at least 32 random characters; AULALITE_DATA_ENCRYPTION_KEY must be
# base64 for exactly 32 random bytes. PREVIOUS stays blank outside a documented
# key-rotation window.
SSO_SESSION_SECRET=
AULALITE_DATA_ENCRYPTION_KEY=
AULALITE_DATA_ENCRYPTION_KEY_PREVIOUS=

# Redis-backed edge/auth/MFA throttle thresholds. Production Compose hardcodes
# the main switch on.
AULALITE_RATE_LIMIT_WINDOW_SECS=60
AULALITE_RATE_LIMIT_AUTH=120
AULALITE_RATE_LIMIT_ANON=30
AULALITE_RATE_LIMIT_EDGE=600
AULALITE_RATE_LIMIT_MFA=10

# Optional DKIM signing for supported outbound flows.
AULALITE_DKIM_SELECTOR=
AULALITE_DKIM_DOMAIN=
AULALITE_DKIM_PRIVATE_KEY=

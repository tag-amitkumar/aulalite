# AulaLite local-development environment template.
# Copy this file to .env and replace blank placeholders as needed. Values here
# are examples only; never reuse them for staging or production.
# Dokploy has a separate fail-closed production contract in
# ops/dokploy.env.example; completed environment files must never enter Git.

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
APP_ENV=local
APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:8080
AULALITE_BROWSER_ORIGINS=http://localhost:3000
# Comma-separated Firebase email identities that receive platform-wide access.
# Production must set at least one address; local development may leave it blank.
AULALITE_SUPER_ADMIN_EMAILS=
BIND_ADDR=0.0.0.0:8080
RUST_LOG=info,backend=debug,sqlx=warn
# Public Firebase identities without an existing invitation receive one academy
# and an org_owner membership. Defaults on only in explicit local/dev/test
# environments; production deployments must set this choice explicitly.
SELF_SERVICE_SIGNUP_ENABLED=true

# -----------------------------------------------------------------------------
# PostgreSQL and Redis
# -----------------------------------------------------------------------------
POSTGRES_USER=aulalite
# NOT a bootstrap-only variable, despite the name.
#
# The postgres image reads POSTGRES_PASSWORD only when it initialises a BRAND
# NEW data volume; on an existing volume the entrypoint ignores it entirely.
# But this same password is also embedded in the DATABASE_URL /
# MIGRATION_DATABASE_URL below, which the backend uses on every connection. So:
#
#   * editing this value on a running deployment changes NOTHING in the
#     database -- the role keeps its old password and the backend then fails to
#     authenticate, because only the URLs moved;
#   * rotating for real means `ALTER ROLE <POSTGRES_USER> WITH PASSWORD '...'`
#     inside the running database FIRST, then updating this value and ALL FOUR
#     URLs below together, then recreating the backend (compose interpolates
#     ${VAR} at container CREATE time, so `restart` will not pick it up).
#
# Rotate the *_LOCAL URLs in the same pass. They are easy to miss because
# nothing in the container stack reads them -- they exist for tooling run from
# the host against the published port -- and a half-rotation leaves them
# silently broken until someone reaches for psql.
POSTGRES_PASSWORD=local-only-change-me
POSTGRES_DB=aulalite
# Used by the standalone Dokploy stack to bootstrap the least-privileged
# `aulalite_app` role on a fresh Postgres volume. Production must use a unique
# raw value matching the logical password URL-percent-encoded in DATABASE_URL.
POSTGRES_RUNTIME_PASSWORD=local-runtime-only-change-me

# DATABASE_URL is the application runtime connection. MIGRATION_DATABASE_URL is
# the schema-owner connection used only during startup migration. They are the
# same owner role locally for convenience; production must use separate roles.
#
# Every `*-change-me` value in this file is a PLACEHOLDER, not a default to run
# with. They are published in this template, so any deployment still using one
# has, in effect, no password at all. This is not hypothetical: a live origin
# was found serving on exactly these values. Prefer a URL-safe generated
# password ([A-Za-z0-9], 32+ chars) -- it embeds in the URLs below with no
# percent-encoding, removing the mismatch between the raw value and its encoded
# form that quietly breaks half a rotation.
DATABASE_URL=postgres://aulalite:local-only-change-me@postgres:5432/aulalite
MIGRATION_DATABASE_URL=postgres://aulalite:local-only-change-me@postgres:5432/aulalite
DATABASE_URL_LOCAL=postgres://aulalite:local-only-change-me@localhost:55432/aulalite
MIGRATION_DATABASE_URL_LOCAL=postgres://aulalite:local-only-change-me@localhost:55432/aulalite
# Pool bounds protect Postgres during traffic spikes and recycle long-lived
# connections so DNS/network/database maintenance converges cleanly.
DB_MAX_CONNECTIONS=20
DB_MIN_CONNECTIONS=0
DB_ACQUIRE_TIMEOUT_SECS=10
DB_IDLE_TIMEOUT_SECS=600
DB_MAX_LIFETIME_SECS=1800
REDIS_URL=redis://redis:6379

# -----------------------------------------------------------------------------
# Firebase identity and publishable browser configuration
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your-firebase-project
FIREBASE_JWKS_URL=https://www.googleapis.com/service_accounts/v1/jwk/securetoken@system.gserviceaccount.com
FIREBASE_TOKEN_ISSUER=https://securetoken.google.com/your-firebase-project
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=your-firebase-project.firebaseapp.com
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
# Firebase Android app identifier (`...:android:...`), not the browser app ID.
FIREBASE_ANDROID_APP_ID=
FIREBASE_MEASUREMENT_ID=
FCM_VAPID_KEY=
# Local-login development can run without Firebase browser config. Production
# Compose forces this validation back on.
AULALITE_REQUIRE_FIREBASE_CONFIG=false

# Native debug clients may read the same publishable Firebase key and API
# origin from this ignored local file. Release builds ignore runtime `.env`
# overrides and embed protected build-environment values; their API value must
# be a bare HTTPS origin. Desktop debug defaults to localhost and Android-
# emulator debug to 10.0.2.2. `auto` uses the OS credential provider.
AULALITE_API_BASE_URL=
AULALITE_APP_ORIGIN=http://localhost:3000
AULALITE_ADMIN_ORIGIN=
AULALITE_TOKEN_STORE=auto
# Native deep-link and external-browser allowlists. Bundle metadata currently
# registers aula.elementors.guru; keep this value aligned with Dioxus.toml and
# the deployed AASA/assetlinks files. Comma-separate any additional hosts.
AULALITE_APP_LINK_HOST=aula.elementors.guru
AULALITE_BILLING_HOSTS=checkout.stripe.com,billing.stripe.com
AULALITE_CONTENT_HOSTS=aula.elementors.guru,storage.elementors.guru
AULALITE_SSO_HOSTS=
# Device harness only. Production APNs/FCM tokens must enter through the native
# host callback and secure store, never be embedded in a release bundle.
AULALITE_NATIVE_PUSH_TOKEN=

# -----------------------------------------------------------------------------
# Local-only sign-in and deterministic audit seed
# -----------------------------------------------------------------------------
# These routes remain disabled unless both APP_ENV is non-production and the
# relevant switch is true. Production Compose forces both switches false.
LOCAL_LOGIN_BYPASS_ENABLED=false
LOCAL_LOGIN_TOKEN=
LOCAL_LOGIN_TEACHER_TOKEN=
LOCAL_LOGIN_EMAIL=local.teacher@example.test
LOCAL_LOGIN_DISPLAY_NAME=Local Teacher
LOCAL_LOGIN_FIREBASE_UID=local-login-local-teacher
LOCAL_LOGIN_STUDENT_TOKEN=
LOCAL_LOGIN_STUDENT_EMAIL=local.student@example.test
LOCAL_LOGIN_STUDENT_DISPLAY_NAME=Local Student
LOCAL_LOGIN_STUDENT_FIREBASE_UID=local-login-local-student
LOCAL_LOGIN_TEACHER_PASSWORD=local-teacher-pass
LOCAL_LOGIN_STUDENT_PASSWORD=local-student-pass
LOCAL_AUDIT_SEED_ENABLED=false

# -----------------------------------------------------------------------------
# Object storage (RustFS / S3-compatible)
# -----------------------------------------------------------------------------
# Browser-facing signing origin and backend-only control/data endpoint. Keeping
# them separate makes local presigned URLs reachable without exposing an
# internal service hostname to the browser.
S3_ENDPOINT_URL=http://localhost:9000
S3_INTERNAL_ENDPOINT_URL=http://rustfs:9000
S3_REGION=us-east-1
S3_BUCKET=aulalite
AWS_ACCESS_KEY_ID=aulalite
AWS_SECRET_ACCESS_KEY=changeme123

# -----------------------------------------------------------------------------
# Live media, recording, ICE, and retention
# -----------------------------------------------------------------------------
JWT_RS256_PRIVATE_KEY_PEM=
MEDIAMTX_HTTP_URL=http://mediamtx:9997
MEDIAMTX_PUBLIC_WEBRTC_URL=http://localhost:8889
MEDIAMTX_PUBLIC_HLS_URL=http://localhost:8888
# Comma-separated ICE candidate hosts (DNS names and/or IPs; no scheme/port).
# Production must advertise the public media node; local Docker uses loopback.
MEDIAMTX_ADDITIONAL_HOSTS=127.0.0.1
MEDIAMTX_AUTH_SHARED_HEADER=changeme-mediamtx-auth-shared-secret
RECORDINGS_DIR=/recordings
LIVE_ROOM_CHAT_RETENTION_DAYS=90
LIVE_ROOM_RECORDING_RETENTION_DAYS=365

# TURN is strongly recommended outside a single trusted network.
AULALITE_TURN_URL=
AULALITE_TURN_USERNAME=
AULALITE_TURN_CREDENTIAL=

# -----------------------------------------------------------------------------
# Billing
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3000/admin/billing?status=success
STRIPE_CANCEL_URL=http://localhost:3000/admin/billing?status=cancel
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_PRO=

# -----------------------------------------------------------------------------
# Transactional email, push, and optional DKIM
# -----------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM=AulaLite <notifications@example.test>

# FCM HTTP v1 accepts either one-line service-account JSON or a mounted file.
# Do not set both. Keep server credentials out of frontend/browser variables.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
FCM_SERVICE_ACCOUNT_JSON_PATH=
FCM_TOKEN_URI=https://oauth2.googleapis.com/token
FCM_BASE_URL=https://fcm.googleapis.com

AULALITE_DKIM_SELECTOR=
AULALITE_DKIM_DOMAIN=
AULALITE_DKIM_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# Enterprise auth and MFA
# -----------------------------------------------------------------------------
# Generate a unique value of at least 32 characters. Required in production;
# signs enterprise SSO, LTI, and MFA step-up sessions.
SSO_SESSION_SECRET=
# Base64 of 32 random bytes. Required in production; encrypts TOTP and tenant
# OIDC client secrets at rest. PREVIOUS must be a distinct valid key and should
# be set only during the staged rolling-rotation procedure in ops/README.md.
AULALITE_DATA_ENCRYPTION_KEY=
AULALITE_DATA_ENCRYPTION_KEY_PREVIOUS=
# Production startup requires true. Local/dev may set false while bootstrapping.
AULALITE_MFA_ENFORCE=false

# -----------------------------------------------------------------------------
# API rate limiting (Redis-backed)
# -----------------------------------------------------------------------------
AULALITE_RATE_LIMIT=false
AULALITE_RATE_LIMIT_WINDOW_SECS=60
AULALITE_RATE_LIMIT_AUTH=120
AULALITE_RATE_LIMIT_ANON=30
# Aggregate ceiling for all credential-bearing traffic from one network. This
# prevents fake-token bucket rotation while leaving room for shared campuses.
AULALITE_RATE_LIMIT_EDGE=600
AULALITE_RATE_LIMIT_MFA=10
